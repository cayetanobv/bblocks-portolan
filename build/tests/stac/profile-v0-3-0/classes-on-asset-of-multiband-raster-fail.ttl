@prefix dct: <http://purl.org/dc/terms/> .
@prefix ns1: <https://w3id.org/ogc/stac/assets/> .
@prefix ns2: <http://www.iana.org/assignments/> .
@prefix ns3: <classification:> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix stac: <https://w3id.org/ogc/stac/core/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<file:///github/workspace/valencia-2024-multiband> a stac:Collection ;
    dct:description "Negative test derived from the multiband classified raster test. The COG has two bands, but the class list sits on the asset instead of on each band in the STAC 1.1 bands array, so it fails the multiband placement rule (PORTO-FMT-050)." ;
    dct:extent [ ] ;
    dct:license "other" ;
    dct:subject "DANA",
        "SAR",
        "Sentinel-1",
        "Valencia",
        "flood" ;
    dct:title "Flood classification and confidence, Valencia, Spain, October 2024 (GEP SAR Features, Sentinel-1)" ;
    rdfs:seeAlso [ rdfs:label "Guidance for AI agents" ;
            dct:type "text/markdown" ;
            ns2:relation <http://www.iana.org/assignments/relation/agents> ;
            oa:hasTarget <file:///github/workspace/AGENTS.md> ],
        [ dct:type "application/json" ;
            ns2:relation <http://www.iana.org/assignments/relation/parent> ;
            oa:hasTarget <file:///github/catalog.json> ],
        [ rdfs:label "Human-readable documentation" ;
            dct:type "text/markdown" ;
            ns2:relation <http://www.iana.org/assignments/relation/describedby> ;
            oa:hasTarget <file:///github/workspace/README.md> ],
        [ rdfs:label "Geohazards Exploitation Platform (GEP), the original source" ;
            dct:type "text/html" ;
            ns2:relation <http://www.iana.org/assignments/relation/via> ;
            oa:hasTarget <https://geohazards-tep.eu/> ],
        [ dct:type "application/json" ;
            ns2:relation <http://www.iana.org/assignments/relation/root> ;
            oa:hasTarget <file:///github/catalog.json> ],
        [ rdfs:label "Terms of use" ;
            dct:type "text/html" ;
            ns2:relation <http://www.iana.org/assignments/relation/license> ;
            oa:hasTarget <file:///github/workspace/LICENSE.html> ] ;
    stac:hasAsset [ ns1:data <file:///github/workspace/sar-features-flood-confidence-cog.tif> ;
            ns1:thumbnail <file:///github/workspace/thumbnail.png> ] ;
    stac:hasExtension "https://schemas.portolan-sdi.org/portolan/v0.3.0/schema.json",
        "https://stac-extensions.github.io/classification/v2.0.0/schema.json" ;
    stac:hasProvider [ ],
        [ ] ;
    stac:version "1.1.0" .

<file:///github/workspace/sar-features-flood-confidence-cog.tif> ns3:classes [ dct:title "Flooded bare soil" ;
            ns1:color_hint "00FF00" ;
            ns1:name "bare-soil-flood" ;
            ns1:value 3 ],
        [ dct:title "Permanent water" ;
            ns1:color_hint "0000FF" ;
            ns1:name "permanent-water" ;
            ns1:value 2 ],
        [ dct:title "Urban" ;
            ns1:color_hint "000000" ;
            ns1:name "urban" ;
            ns1:value 1 ],
        [ dct:title "Other" ;
            ns1:name "other" ;
            ns1:value 0 ],
        [ dct:title "Flooded urban area" ;
            ns1:color_hint "00FFFF" ;
            ns1:name "urban-flood" ;
            ns1:value 4 ] ;
    dct:description "Discrete two-band uint8 COG. Band 1 is the flood class, band 2 the classification confidence. Value 0 is nodata in both bands." ;
    dct:format "image/tiff; application=geotiff; profile=cloud-optimized" ;
    dct:title "Flood classification and confidence (COG)" ;
    ns1:bands [ dct:description "Confidence of the flood classification" ;
            ns1:data_type "uint8" ;
            ns1:name "confidence" ;
            ns1:nodata 0 ],
        [ dct:description "Flood classification" ;
            ns1:data_type "uint8" ;
            ns1:name "flood_class" ;
            ns1:nodata 0 ] ;
    stac:hasAssetroles "data"^^<xsd:string> .

<file:///github/workspace/thumbnail.png> dct:format "image/png" ;
    dct:title "Preview drawn from the embedded color table" ;
    stac:hasAssetroles "thumbnail"^^<xsd:string> .

