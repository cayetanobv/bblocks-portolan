@prefix dct: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.iana.org/assignments/> .
@prefix ns2: <classification:> .
@prefix ns3: <https://w3id.org/ogc/stac/assets/> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix stac: <https://w3id.org/ogc/stac/core/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<file:///github/workspace/valencia-2024-multiband> a <file:///github/workspace/Collection> ;
    dct:description "Negative test derived from the multiband classified raster test. The COG has two bands, but the class list sits on the asset instead of on each band in the STAC 1.1 bands array, so it fails the multiband placement rule (PORTO-FMT-050)." ;
    dct:extent [ ] ;
    dct:license "other" ;
    dct:subject "DANA",
        "SAR",
        "Sentinel-1",
        "Valencia",
        "flood" ;
    dct:title "Flood classification and confidence, Valencia, Spain, October 2024 (GEP SAR Features, Sentinel-1)" ;
    rdfs:seeAlso [ rdfs:label "Human-readable documentation" ;
            dct:type "text/markdown" ;
            ns1:relation <http://www.iana.org/assignments/relation/describedby> ;
            oa:hasTarget <file:///github/workspace/README.md> ],
        [ dct:type "application/json" ;
            ns1:relation <http://www.iana.org/assignments/relation/root> ;
            oa:hasTarget <file:///github/catalog.json> ],
        [ rdfs:label "Guidance for AI agents" ;
            dct:type "text/markdown" ;
            ns1:relation <http://www.iana.org/assignments/relation/agents> ;
            oa:hasTarget <file:///github/workspace/AGENTS.md> ],
        [ rdfs:label "Terms of use" ;
            dct:type "text/html" ;
            ns1:relation <http://www.iana.org/assignments/relation/license> ;
            oa:hasTarget <file:///github/workspace/LICENSE.html> ],
        [ dct:type "application/json" ;
            ns1:relation <http://www.iana.org/assignments/relation/parent> ;
            oa:hasTarget <file:///github/catalog.json> ] ;
    stac:hasAsset [ ns3:data <file:///github/workspace/sar-features-flood-confidence-cog.tif> ;
            ns3:thumbnail <file:///github/workspace/thumbnail.png> ] ;
    stac:hasExtension "https://schemas.portolan-sdi.org/portolan/v0.3.0/schema.json",
        "https://stac-extensions.github.io/classification/v2.0.0/schema.json" ;
    stac:hasProvider [ ],
        [ ] ;
    stac:version "1.1.0" .

<file:///github/workspace/sar-features-flood-confidence-cog.tif> ns2:classes [ dct:title "Flooded urban area" ;
            ns3:color_hint "00FFFF" ;
            ns3:name "urban-flood" ;
            ns3:value 4 ],
        [ dct:title "Other" ;
            ns3:name "other" ;
            ns3:nodata true ;
            ns3:value 0 ],
        [ dct:title "Permanent water" ;
            ns3:color_hint "0000FF" ;
            ns3:name "permanent-water" ;
            ns3:value 2 ],
        [ dct:title "Flooded bare soil" ;
            ns3:color_hint "00FF00" ;
            ns3:name "bare-soil-flood" ;
            ns3:value 3 ],
        [ dct:title "Urban" ;
            ns3:color_hint "000000" ;
            ns3:name "urban" ;
            ns3:value 1 ] ;
    dct:description "Discrete two-band uint8 COG. Band 1 is the flood class, band 2 the classification confidence. Value 0 is nodata in both bands." ;
    dct:format "image/tiff; application=geotiff; profile=cloud-optimized" ;
    dct:title "Flood classification and confidence (COG)" ;
    ns3:bands [ dct:description "Confidence of the flood classification" ;
            ns3:data_type "uint8" ;
            ns3:name "confidence" ;
            ns3:nodata 0 ],
        [ dct:description "Flood classification" ;
            ns3:data_type "uint8" ;
            ns3:name "flood_class" ;
            ns3:nodata 0 ] ;
    stac:hasAssetroles "data"^^<xsd:string> .

<file:///github/workspace/thumbnail.png> dct:format "image/png" ;
    dct:title "Preview drawn from the embedded color table" ;
    stac:hasAssetroles "thumbnail"^^<xsd:string> .

