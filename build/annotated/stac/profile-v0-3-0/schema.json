{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portolan STAC Profile",
  "description": "A STAC Catalog or Collection that conforms to the Portolan specification v0.3.0. The object is a STAC 1.x Collection (via the STAC Collection building block) or a STAC 1.1 Catalog, and it validates against the Portolan schema of record.",
  "allOf": [
    {
      "anyOf": [
        {
          "$ref": "https://ogcincubator.github.io/bblocks-stac/build/annotated/contrib/stac/collection/schema.json"
        },
        {
          "$ref": "https://schemas.stacspec.org/v1.1.0/catalog-spec/json-schema/catalog.json"
        }
      ]
    },
    {
      "$ref": "https://schemas.portolan-sdi.org/portolan/v0.3.0/schema.json"
    }
  ],
  "x-jsonld-extra-terms": {
    "Catalog": "https://w3id.org/ogc/stac/core/Catalog",
    "Collection": "https://w3id.org/ogc/stac/core/Collection"
  },
  "x-bblocks-metadata": {
    "itemIdentifier": "portolan.stac.profile-v0-3-0",
    "register": "https://cayetanobv.github.io/bblocks-portolan/build/register.json",
    "version": "0.3.0",
    "dateOfLastChange": "2026-11-24"
  }
}