<bblocks://portolan.stac.profile> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "Portolan STAC Profile" ;
    dct:abstract "A STAC Catalog or Collection that conforms to the Portolan specification v0.3.0: cloud-native assets on object storage with https access, a pinned set of STAC extensions, and AGENTS.md and README.md links on every catalog and collection."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-09-08T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://cayetanobv.github.io/bblocks-portolan/bblock/portolan.stac.profile> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://cayetanobv.github.io/bblocks-portolan/build/generateddocs/markdown/stac/profile/index.md> ],
        [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://cayetanobv.github.io/bblocks-portolan/build/generateddocs/json-full/stac/profile/index.json> ] ;
    dct:hasVersion "0.3.0" ;
    dct:license [ rdfs:label "Apache-2.0" ;
            rdfs:seeAlso <https://www.apache.org/licenses/LICENSE-2.0> ] ;
    dct:modified "2026-11-20"^^xsd:date ;
    dct:source <https://github.com/portolan-sdi/portolan-spec/blob/v0.3.0/specs/portolan/core.md>,
        <https://github.com/portolan-sdi/portolan-spec/blob/v0.3.0/specs/portolan/formats.md>,
        <https://github.com/portolan-sdi/portolan-spec/blob/v0.3.0/stac/README.md>,
        <https://schemas.portolan-sdi.org/portolan/v0.3.0/schema.json> ;
    skos:inScheme <https://cayetanobv.github.io/bblocks-portolan/> ;
    skos:prefLabel "Portolan STAC Profile" ;
    skos:topConceptOf <https://cayetanobv.github.io/bblocks-portolan/> ;
    dcat:keyword "cloud-native",
        "geoparquet",
        "pmtiles",
        "portolan",
        "profile",
        "stac" ;
    prof:hasResource [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.contrib.stac.extensions.raster-ontology> ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-stac/_sources/extensions/raster-ontology/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.contrib.stac.extensions.classification-ontology> ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-stac/_sources/extensions/classification-ontology/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.api.records.v1.schemas.linkTemplate> ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-ogcapi-records/_sources/v1/schemas/linkTemplate/rules.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo <https://www.w3.org/TR/json-ld11/> ;
            dct:format "application/ld+json" ;
            prof:hasArtifact <https://cayetanobv.github.io/bblocks-portolan/build/annotated/stac/profile/context.jsonld> ;
            prof:hasRole role:mapping ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.contrib.stac.components.assets-ontology> ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-stac/_sources/components/assets-ontology/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.contrib.stac.core-ontology> ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-stac/_sources/core-ontology/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/json" ;
            prof:hasArtifact <https://cayetanobv.github.io/bblocks-portolan/build/annotated/stac/profile/schema.json> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo <https://json-schema.org/draft/2020-12/schema> ;
            dct:format "application/yaml" ;
            prof:hasArtifact <https://cayetanobv.github.io/bblocks-portolan/build/annotated/stac/profile/schema.yaml> ;
            prof:hasRole role:schema ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.model.cross-domain.prov> ;
            prof:hasArtifact <https://ogcincubator.github.io/cross-domain-model/_sources/prov/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.contrib.stac.extensions.themes-ontology> ;
            prof:hasArtifact <https://ogcincubator.github.io/bblocks-stac/_sources/extensions/themes-ontology/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.geo.features.feature> ;
            prof:hasArtifact <https://opengeospatial.github.io/bblocks/registereditems/geo/features/feature/shapes.shacl> ;
            prof:hasRole role:validation ] ;
    prof:isProfileOf <bblocks://ogc.contrib.stac.collection> ;
    bblocks:dependsOn <bblocks://ogc.contrib.stac.collection>,
        <bblocks://ogc.contrib.stac.extensions.classification>,
        <bblocks://ogc.contrib.stac.extensions.datacube>,
        <bblocks://ogc.contrib.stac.extensions.file>,
        <bblocks://ogc.contrib.stac.extensions.raster>,
        <bblocks://ogc.contrib.stac.extensions.scientific>,
        <bblocks://ogc.contrib.stac.extensions.themes>,
        <bblocks://ogc.contrib.stac.extensions.version> ;
    bblocks:scope <http://www.opengis.net/def/bblocks/scope/contrib> ;
    bblocks:status <http://www.opengis.net/def/status/under-development> ;
    bblocks:validationPassed true .

