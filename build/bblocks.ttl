<https://cayetanobv.github.io/bblocks-portolan/> a skos:ConceptScheme,
        dcat:Catalog,
        bblocks:BBlocksRegister ;
    rdfs:label "Building Blocks - Portolan Building Blocks" ;
    dct:abstract """OGC Building Blocks for the [Portolan specification](https://github.com/portolan-sdi/portolan-spec):
the Portolan STAC profile and the STAC extensions Portolan defines.
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:description """Portolan is an open specification for cloud-native geospatial data catalogs. Every Portolan
catalog is a static STAC catalog on plain HTTPS object storage, with cloud-native assets and
guidance files that both people and AI agents read.

This register wraps the published Portolan artifacts as Building Blocks. It does not redefine
them. The schema of record is `https://schemas.portolan-sdi.org/portolan/<version>/schema.json`,
the profile text lives in `portolan-spec/stac/README.md`, and rules the schema cannot express are
checked by the [rashid](https://github.com/portolan-sdi/rashid) validator.
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:license [ rdfs:label "Apache-2.0" ;
            rdfs:seeAlso <https://www.apache.org/licenses/LICENSE-2.0> ] ;
    dct:modified "2026-11-20T13:13:30.553174"^^xsd:dateTime ;
    owl:imports <https://ogcincubator.github.io/bblocks-stac/build/register.json>,
        <https://opengeospatial.github.io/bblocks/register.json> ;
    skos:hasTopConcept <bblocks://portolan.stac.profile> ;
    skos:prefLabel "Building Blocks - Portolan Building Blocks" ;
    prof:hasResource [ rdfs:label "This Building Blocks Register in RDF Turtle format" ;
            dct:type "text/turtle" ;
            ns1:relation <http://www.iana.org/assignments/relation/self> ;
            ns2:hasTarget <https://cayetanobv.github.io/bblocks-portolan/build/bblocks.ttl> ],
        [ rdfs:label "This Building Blocks Register in JSON-LD format" ;
            dct:type "application/ld+json" ;
            ns1:relation <http://www.iana.org/assignments/relation/self> ;
            ns2:hasTarget <https://cayetanobv.github.io/bblocks-portolan/build/bblocks.jsonld> ],
        [ rdfs:label "This Building Blocks Register in JSON format" ;
            dct:type "application/json" ;
            ns1:relation <http://www.iana.org/assignments/relation/self> ;
            ns2:hasTarget <https://cayetanobv.github.io/bblocks-portolan/build/register.json> ] ;
    foaf:homepage <https://cayetanobv.github.io/bblocks-portolan/> ;
    bblocks:hasValidationReport <https://cayetanobv.github.io/bblocks-portolan/build/tests/report.html> .

